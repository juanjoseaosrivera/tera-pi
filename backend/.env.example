# Copia este fichero como .env y rellénalo. El .env NUNCA se sube a git.

# local | production
ENVIRONMENT=local

# Local: la base de datos del docker-compose.yml de la RAÍZ del repo (Percona 8.4).
#   Sustituye CONTRASEÑA por el valor de MYSQL_PASSWORD del .env de la raíz.
# Producción: mysql+pymysql://terapiapp:CONTRASEÑA@127.0.0.1:3306/terapi?charset=utf8mb4
# Si la contraseña tiene caracteres como @ : / % #, escríbela codificada (por ejemplo @ = %40).
DATABASE_URL=mysql+pymysql://terapiapp:CONTRASEÑA@127.0.0.1:3306/terapi?charset=utf8mb4

# Clave de cifrado de los datos sensibles. Genera una con:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guárdala también en tu gestor de contraseñas: si se pierde, esos datos no se pueden recuperar.
DATA_ENCRYPTION_KEY=

# ElevenLabs. Los tres valores los da el script elevenlabs/deploy_agent.py (ver elevenlabs/README.md).
# API key del BACKEND: con permisos mínimos (solo Agents). No es la key de administración.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Secreto HMAC del webhook post-llamada. ElevenLabs solo lo muestra una vez, al crearlo.
ELEVENLABS_WEBHOOK_SECRET=

# Secreto que el agente envía en la cabecera X-Tool-Secret de las server tools. Genera uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TOOLS_SHARED_SECRET=

# Orígenes del frontend, separados por comas.
CORS_ORIGINS=http://localhost:4200,https://tera-pi.pygmalion.cloud

# TEMPORAL (solo para el spike): permite identificarse con la cabecera X-Dev-User-Email.
ALLOW_DEV_AUTH=true
# Emails que pueden usar ese login de prueba, separados por comas. En producción es obligatorio
# si ALLOW_DEV_AUTH=true (la API no arranca sin él). En local puede quedar vacío.
DEV_AUTH_ALLOWED_EMAILS=
# Token que debe enviarse en la cabecera X-Dev-Token junto al email. Obligatorio en producción
# (32 caracteres o más). Genera uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# En local puede quedar vacío (sin token).
DEV_AUTH_TOKEN=
